{
  "permissions": {
    "allow": [
      "Read(/Users/alfa/.claude/skills/**)",
      "Read(/Users/alfa/.claude/skills/**/SKILL.md)",
      "Read(/Users/alfa/.claude/skills/**/references/**)",
      "Read(/Users/alfa/.claude/skills/**/scripts/**)",
      "Read(/Users/alfa/.claude/skills/**/assets/**)"
    ],
    "ask": [],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .delta-11/hooks/heartbeat.sh",
            "timeout": 2000
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .delta-11/hooks/log-activity.js",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/regenerar-contratos.py || python .delta-11/hooks/regenerar-contratos.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/guarda-worktree.py || python .delta-11/hooks/guarda-worktree.py",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/contraposicao-checker.py || python .delta-11/hooks/contraposicao-checker.py",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .delta-11/hooks/check-lock.js",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/pre-selo.py || python .delta-11/hooks/pre-selo.py",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/validar-contratos-fim-fase.py || python .delta-11/hooks/validar-contratos-fim-fase.py",
            "timeout": 300000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/validar-arquitetura-vs-modelos.py || python .delta-11/hooks/validar-arquitetura-vs-modelos.py",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/fase-ritmo-checker.py || python .delta-11/hooks/fase-ritmo-checker.py",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/pre-leitura.py || python .delta-11/hooks/pre-leitura.py",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/pre-despacho.py || python .delta-11/hooks/pre-despacho.py",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/pre-criacao-arquivo.py || python .delta-11/hooks/pre-criacao-arquivo.py",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/gc-locks.py || python .delta-11/hooks/gc-locks.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .delta-11/hooks/validar-deploy.py || python .delta-11/hooks/validar-deploy.py",
            "timeout": 600000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .delta-11/hooks/pre-compact.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .delta-11/hooks/on-stop.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node .delta-11/hooks/release-locks.js",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
