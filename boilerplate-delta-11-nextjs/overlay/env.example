# Variáveis de ambiente — NOMES apenas, nunca valores reais (regra de segurança global).
# Copie para .env.local e preencha. Toda variável nova: adicione aqui E em src/lib/env.ts.

# Supabase (banco de dados + autenticação)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoramento de erros (Sentry — preencher quando instalar, pré-produção)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
