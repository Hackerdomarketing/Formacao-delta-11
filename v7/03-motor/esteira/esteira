FALHA_FORTE = re.compile(r"(?:^|\s)(?:error|erro|fatal error)\s*:|\bFAIL(?:ED|URE)?\b|\bfailed\b|^not ok\b|\bAssertionError\b|\bpanic(?:ked)?\b"
                         r"|\bTraceback\b|\bFALHOU\b", re.IGNORECASE)
FALHA_FRACA = re.compile(r"fail|falh|error|erro|not ok|assert|denied|negad|not permitted|não permitid|cannot|can't|"
                         r"não consegu|fatal|panic|exception|traceback|no such|not found|não encontr", re.IGNORECASE)
CAMINHO = re.compile(r"(?:[\w.~-]*/)+[\w.-]+")


def ultima_linha(saida):
    """A linha da falha, para o resumo curto: a primeira com marca forte de erro (`error:`, `FAIL`, `failed`, `not ok`) que
    cita um arquivo com número de linha; senão a última com marca forte; senão a última com uma palavra de erro fora dos
    caminhos (`erros/LEIAME.md` não é erro); senão a última linha. Com a dica, se a causa é conhecida."""
    linhas = [l.strip() for l in saida.splitlines() if l.strip()]
    fortes = [l for l in linhas if FALHA_FORTE.search(CAMINHO.sub(" ", l))]
    com_lugar = ([l for l in fortes if re.search(r"[\w.-]+\.\w+:\d+(?::\d+)?:\s*(?:error|erro|fatal error)\b", l, re.IGNORECASE)]
                 or [l for l in fortes if re.search(r"\bFatal error\b.*\bline \d+|[\w.-]+\.\w+:\d+", l)])
    fracas = [l for l in linhas if FALHA_FRACA.search(CAMINHO.sub(" ", l))]
    linha = ((com_lugar[:1] or fortes[-1:] or fracas[-1:] or linhas[-1:] or ["sem saída"])[0])[:300]
    if re.search(r"sandbox[-_ ]?(?:exec|apply)?\W.*(?:not permitted|denied)", saida, re.IGNORECASE):
        linha += " (dentro da caixa do produto, a caixa do próprio programa não abre: desligue-a no comando, como `--disable-sandbox` no SwiftPM)"
    return linha


# ---------------------------------------------------------------- os comandos do produto
def ler_comandos(texto, tolerante=False):
    comandos = {}
    for n, linha in enumerate(texto.splitlines(), 1):
        limpa = linha.strip()
        if not limpa or limpa.startswith("#"):
            continue
        achado = re.match(r"([a-z-]+)\s*:\s*(.*)$", limpa)
        if not achado or achado.group(1) not in CHAVES or (achado.group(1) in comandos and achado.group(1) not in REPETIVEIS):
            if tolerante:
                continue
            recusar("%s fora do formato na linha %d ('%s'). Este é %s" % (COMANDOS, n, limpa[:60], FORMATO))
        if achado.group(1) in REPETIVEIS:
            comandos.setdefault(achado.group(1), []).append(achado.group(2).strip())
        else:
            comandos[achado.group(1)] = achado.group(2).strip()
    return comandos


def comandos_de(pasta):
    caminho = os.path.join(pasta, COMANDOS)
    if not os.path.isfile(caminho):
        recusar("falta %s na raiz: a esteira é do motor, e os comandos do produto, do BACK. Este é %s" % (COMANDOS, FORMATO))
    comandos = ler_comandos(open(caminho, encoding="utf-8", errors="replace").read())
    for chave in ("testar", "testes"):
        if not comandos.get(chave):
            recusar("%s sem a linha `%s:`. Este é %s" % (COMANDOS, chave, FORMATO))
    return comandos


def padroes_de_teste(comandos):
