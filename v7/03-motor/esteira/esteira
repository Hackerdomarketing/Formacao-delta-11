#!/bin/sh
# A esteira do Delta-11 v7: o programa do MOTOR (o instalador a põe na raiz do produto e a troca; ninguém do produto a muda).
# O contrato: .delta-11/motor/modelos/esteira.md. Os comandos do produto (montar, testar, publicar): esteira-comandos.txt.
# Na raiz, sozinha na linha: sh esteira <nome> <arquivos>. Roda a versão do último commit, não a da pasta (sem a esteira
# no último commit, a da pasta). O que vem depois da marca é Python, rodado isolado (-I -B).
if git cat-file -e HEAD:esteira 2>/dev/null; then
  PROGRAMA=$(git show HEAD:esteira | sed '1,/^#PYTHON$/d')
else
  PROGRAMA=$(sed '1,/^#PYTHON$/d' "$0")
fi
[ -n "$PROGRAMA" ] || { echo "RECUSOU: não consegui ler o programa da esteira (o último commit ou a pasta)"; exit 1; }
exec python3 -I -B -c "$PROGRAMA" "$@"
#PYTHON
