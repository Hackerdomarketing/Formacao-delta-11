def em_regex(padrao):
    corpo = ""
    i = 0
    while i < len(padrao):
        if padrao.startswith("**/", i):
            corpo, i = corpo + "(?:.*/)?", i + 3
        elif padrao.startswith("**", i):
            corpo, i = corpo + ".*", i + 2
        elif padrao[i] == "*":
            corpo, i = corpo + "[^/]*", i + 1
        elif padrao[i] == "?":
            corpo, i = corpo + "[^/]", i + 1
        else:
            corpo, i = corpo + re.escape(padrao[i]), i + 1
    return corpo


def e_teste(arquivo, padroes):
    """Um padrão com barra no fim é uma pasta; com barra no meio, vale da raiz; sem barra, o nome em qualquer pasta."""
    for padrao in padroes:
        limpo = padrao.lstrip("/")
        if limpo.endswith("/"):
            if arquivo.startswith(limpo) or ("/" not in limpo.rstrip("/") and ("/" + limpo) in ("/" + arquivo)):
                return True
        elif "/" in limpo:
            if re.fullmatch(em_regex(limpo), arquivo):
                return True
        elif re.fullmatch(em_regex(limpo), arquivo.rsplit("/", 1)[-1]):
            return True
    return False


