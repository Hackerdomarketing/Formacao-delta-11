# ---------------------------------------------------------------- relato (inteiro no arquivo; na tela, só o curto)
class Relato:
    def __init__(self, nome):
        pasta = os.path.join(RAIZ, ".delta-11/esteira")
        os.makedirs(pasta, exist_ok=True)
        agora = datetime.datetime.now()
        carimbo = agora.strftime("%Y-%m-%d-%H%M%S-") + "%03d" % (agora.microsecond // 1000)
        self.caminho = os.path.join(pasta, "%s-%s.log" % (re.sub(r"[^a-z0-9,_-]", "_", nome.lower()) or "esteira", carimbo))
        self.arquivo = open(self.caminho, "a", encoding="utf-8")
        self.escrever("esteira do Delta-11 v7, %s, em %s%s" % (agora.isoformat(timespec="seconds"), RAIZ, " (ensaio)" if ENSAIO else ""))
        global RODANDO
        rodando = os.path.join(pasta, "rodando")
        os.makedirs(rodando, exist_ok=True)
        RODANDO = os.path.join(rodando, "%s-%d" % (re.sub(r"[^a-z0-9,_-]", "_", nome.lower()) or "esteira", os.getpid()))
        andando = [c for c in camadas_abertas() if not situacao(os.path.join(RAIZ, ".delta-11/quadro", c)).startswith("parad")]
        try:
            comeco = subprocess.run(["ps", "-o", "lstart=", "-p", str(os.getpid())], capture_output=True, text=True).stdout.strip()
        except OSError:
            comeco = ""  # dentro de uma caixa (a cópia de ataque), sem o ps: o sinal não vale como esteira viva
        open(RODANDO, "w").write(" ".join(andando) + "\n" + comeco + "\n")  # a hora de início: um número de processo reaproveitado não engana

    def escrever(self, texto):
        self.arquivo.write(texto if texto.endswith("\n") else texto + "\n")
        self.arquivo.flush()

    def dizer(self, texto):
        self.escrever(texto)
        print(texto, flush=True)


def dizer(texto):
    R.dizer(texto)


def rodar(comando, cwd=None, env=None, entrada=None, ver=None):
    """Roda e guarda no relato o comando e a saída inteira. Devolve (código, saída)."""
    R.escrever("$ " + (ver or " ".join(comando)))
    try:
        feito = subprocess.run(comando, cwd=cwd or RAIZ, env=env if env is not None else SEM_GIT, input=entrada,
                               capture_output=True, text=True, errors="replace")
    except OSError as erro:
        R.escrever("não rodou: %s" % erro)
        return 127, str(erro)
    saida = (feito.stdout or "") + (feito.stderr or "")
    if saida.strip():
        R.escrever(saida.rstrip("\n"))
    R.escrever("(código %d)" % feito.returncode)
    return feito.returncode, saida


def git(*args, cwd=None, env=None, entrada=None):
    """O git, sem sujar o relato. Devolve (código, saída)."""
    feito = subprocess.run(["git", *args], cwd=cwd or RAIZ, env=env if env is not None else SEM_GIT, input=entrada,
                           capture_output=True, text=True, errors="replace")
    return feito.returncode, feito.stdout or ""


def git_bytes(*args, cwd=None):
    feito = subprocess.run(["git", *args], cwd=cwd or RAIZ, env=SEM_GIT, capture_output=True)
    return feito.returncode, feito.stdout


