#!/bin/sh
# Lei "um fato, um lugar" do Delta-11 v7, no envio: o que vai para o GitHub passa pelas mesmas conferências do commit.
# Pega o que o commit não pegou (rebase, commit com --no-verify, commit feito noutra máquina sem o gancho).
# O Git passa, pela entrada, uma linha por ramo enviado: <ramo local> <commit local> <ramo remoto> <commit remoto>.
ZERO=0000000000000000000000000000000000000000
FALHOU=0
while read -r REF_LOCAL SHA_LOCAL REF_REMOTO SHA_REMOTO; do
  [ "$SHA_LOCAL" = "$ZERO" ] && continue
  COPIA=$(mktemp -d) || exit 1
  git archive "$SHA_LOCAL" | tar -x -C "$COPIA" || { rm -rf "$COPIA"; exit 1; }
  if [ -d "$COPIA/v7/02-regras" ]; then
    python3 -I "$COPIA/v7/02-regras/ferramentas/conferir-regras.py" >/dev/null || { echo "Envio travado: o vigia das regras falhou em $REF_LOCAL (rode conferir-regras.py)."; FALHOU=1; }
    if [ -d "$COPIA/v7/03-motor" ]; then
      python3 -I -B "$COPIA/v7/03-motor/ferramentas/montar-agentes.py" --conferir >/dev/null || { echo "Envio travado: agentes do motor desatualizados em $REF_LOCAL."; FALHOU=1; }
      python3 -I -B "$COPIA/v7/03-motor/ferramentas/testar-trava.py" >/dev/null || { echo "Envio travado: o pulso da trava falhou em $REF_LOCAL."; FALHOU=1; }
      python3 -I -B "$COPIA/v7/03-motor/ferramentas/testar-esteira.py" >/dev/null || { echo "Envio travado: o pulso da esteira falhou em $REF_LOCAL."; FALHOU=1; }
      python3 -I -B "$COPIA/v7/03-motor/ferramentas/testar-instalador.py" >/dev/null || { echo "Envio travado: o pulso do instalador falhou em $REF_LOCAL."; FALHOU=1; }
    fi
  fi
  rm -rf "$COPIA"
done
exit $FALHOU
